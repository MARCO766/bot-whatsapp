# Panel admin MacBot — emails con acceso (coma-separados, minúsculas recomendadas)
ADMIN_EMAILS=macarias76630@gmail.com

# Sesiones Express (obligatorio en producción)
SESSION_SECRET=pon_un_secreto_largo_aqui

# Cron externo — POST /api/internal/cron/rm24h (Authorization: Bearer ...)
# Seguimientos CRM: NO usar cron HTTP — solo worker interno (jobs/seguimientoWorker.js).
CRON_SECRET=pon_un_secreto_largo_aqui

# Worker seguimientos (ms entre ticks; lock global en Supabase ~28s)
SEGUIMIENTO_POLL_MS=15000
SEGUIMIENTO_WORKER_LOCK_MS=28000

# Supabase — builder RM24H sube con anon key (Settings → API → anon public)
SUPABASE_ANON_KEY=

# Python IA local (opcional — si falla o está apagado, usa iaLocalRouter.js)
USE_PYTHON_AI=false
PYTHON_AI_URL=http://localhost:8000
PYTHON_AI_TIMEOUT_MS=5000

# Recuperación de contraseña (Fase 2 — links en correo)
APP_URL=https://tu-dominio.com
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MacBot <noreply@tudominio.com>
