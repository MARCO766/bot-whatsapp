<link rel="stylesheet" href="/css/crm.css">

<div
  class="whatsapp"
  data-usuario="<%= usuarioId %>"
  data-chat="<%= chatActual %>"
>

  <!-- SIDEBAR -->
  <div class="sidebar">

    <div class="sidebar-top">
      MacBot Inbox
    </div>

    <div class="search">
      <input type="text" placeholder="Buscar chat...">

      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;">
        <a href="/inbox" style="
          background:<%= !etiquetaFiltro ? '#25d366' : '#202c33' %>;
          color:white;
          padding:6px 10px;
          border-radius:8px;
          text-decoration:none;
          font-size:12px;
        ">Todos</a>

        <% etiquetasUnicas.forEach(et => { %>
          <a href="/inbox?etiqueta=<%= encodeURIComponent(et) %>" style="
            background:<%= etiquetaFiltro === et ? (mapaColoresEtiquetas[et] || '#25d366') : '#202c33' %>;
            color:white;
            padding:6px 10px;
            border-radius:8px;
            text-decoration:none;
            font-size:12px;
          "><%= et %></a>
        <% }) %>
      </div>
    </div>

    <div class="chat-list">

      <% numeros.forEach(numero => { %>

        <div
          class="chat-item"
          data-numero="<%= numero %>"
          onclick='cargarChatSinRecargar("<%= numero %>")'
        >

          <div class="avatar"></div>

          <div class="chat-info">
            <h4><%= mapaClientes[numero]?.nombre || numero %></h4>
            <small style="color:#8f9ba8;"><%= numero %></small>

            <% if (mapaUnread[numero] > 0) { %>
  <span class="unread-badge" data-numero="<%= numero %>">
    <%= mapaUnread[numero] %> nuevo
  </span>
<% } %>

            <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:6px;">

              <% etiquetasClientes
                .filter(e => e.cliente_numero === numero)
                .forEach(e => { %>

                  <span class="chat-label-manual" style="
                    background:<%= mapaColoresEtiquetas[e.etiqueta] || '#25d366' %>;
                    color:white;
                    padding:3px 8px;
                    border-radius:999px;
                    font-size:11px;
                    font-weight:bold;
                    border:1px solid <%= mapaColoresEtiquetas[e.etiqueta] || '#25d366' %>;
                  ">
                    <%= e.etiqueta %>
                  </span>

              <% }) %>

            </div>

<%
const ultimoMsg = conversaciones[numero][conversaciones[numero].length - 1];

let previewTexto =
  ultimoMsg?.contenido ||
  ultimoMsg?.tipo ||
  "";

if (previewTexto.startsWith("http")) {

  if (ultimoMsg?.tipo === "image") {
    previewTexto = "📷 Imagen";
  }

  else if (ultimoMsg?.tipo === "audio") {
    previewTexto = "🎧 Audio";
  }

  else if (ultimoMsg?.tipo === "document") {
    previewTexto = "📄 Documento";
  }

  else {
    previewTexto = "📎 Archivo";
  }

}
%>

<p class="chat-last-message" data-numero="<%= numero %>">
  <%= previewTexto.substring(0,30) %>
</p>


          </div>

          <div class="chat-actions" onclick="event.stopPropagation()">
            <button class="chat-dots" onclick='toggleChatMenu("<%= numero %>")'>⋮</button>

            <div class="chat-menu" id="chat_menu_<%= numero %>">

  <a href="#" onclick='abrirMiniEtiqueta("<%= numero %>"); return false;'>
  🏷️ Etiqueta
</a>

  <% if (mapaClientes[numero]?.estado === "bloqueado") { %>

    <a href="/desbloquear-chat?numero=<%= numero %>">
      ✅ Desbloquear
    </a>

  <% } else { %>

    <a
      href="/bloquear-chat?numero=<%= numero %>"
      onclick="return confirm('¿Bloquear este chat?')"
    >
      🚫 Bloquear
    </a>

  <% } %>

  <a
    class="danger"
    href="/eliminar-chat?numero=<%= numero %>"
    onclick="return confirm('¿Eliminar este chat?')"
  >
    🗑️ Eliminar
  </a>

</div>
          </div>

        </div>

      <% }) %>

    </div>

  </div>

<!-- CHAT -->
<div class="chat">

  <div class="chat-top">
    <div class="avatar"></div>

    <div>
      <h3><%= mapaClientes[chatActual]?.nombre || chatActual || "Selecciona un chat" %></h3>
<small style="color:#8f9ba8;"><%= chatActual %></small>
      <small style="color:#25d366;">en línea</small>
    </div>
  </div>

  <div class="chat-messages" id="mensajes">

    <% if (chatActual && conversaciones[chatActual]) { %>

      <% conversaciones[chatActual].forEach(msg => { %>

        <div
  class="message <%= msg.direccion === 'saliente' ? 'saliente' : 'entrante' %>"
  data-whatsapp-id="<%= msg.whatsapp_message_id || '' %>"
>

          <% if ((msg.tipo === "image" || msg.tipo === "imagen") && msg.imagen_url) { %>
            <img src="<%= msg.imagen_url %>" style="max-width:260px;border-radius:10px;display:block;margin-bottom:6px;">
          <% } %>

          <% if ((msg.tipo === "video" || msg.tipo === "video/mp4" || (msg.imagen_url && msg.imagen_url.includes(".mp4"))) && msg.imagen_url) { %>
            <video controls style="max-width:280px;border-radius:10px;display:block;margin-bottom:6px;">
              <source src="<%= msg.imagen_url %>">
            </video>
          <% } %>

          <% if (msg.tipo === "document" && msg.imagen_url) { %>
            <a href="<%= msg.imagen_url %>" target="_blank" style="
              display:block;
              background:#202c33;
              color:#25d366;
              padding:12px;
              border-radius:10px;
              text-decoration:none;
              margin-bottom:6px;
            ">
              📄 Abrir documento
            </a>
          <% } %>

          <% if (msg.tipo === "audio" && msg.imagen_url) { %>
            <audio controls style="width:260px;display:block;margin-bottom:6px;">
              <source src="<%= msg.imagen_url %>">
            </audio>
          <% } %>

          <% if (msg.contenido && !msg.contenido.startsWith("http")) { %>
            <%= msg.contenido %>
          <% } %>

          <span class="time">
  <%= horaBolivia(msg.creado_en) %>

  <% if (msg.direccion === "saliente") { %>
    <% if (msg.estado_envio === "read") { %>
      <span class="msg-status read">✓✓</span>
    <% } else if (msg.estado_envio === "delivered") { %>
      <span class="msg-status delivered">✓✓</span>
    <% } else { %>
      <span class="msg-status sent">✓</span>
    <% } %>
  <% } %>
</span>

        </div>

      <% }) %>

    <% } %>

  </div>


<% if (chatActual || true) { %>

  <div class="chat-bottom">

    <form action="/inbox/responder" method="POST" enctype="multipart/form-data">

      <input type="hidden" name="numero" value="<%= chatActual %>" id="numeroResponder">

      <input
        type="file"
        name="archivo"
        id="archivoChat"
        accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx"
        style="display:none;"
      >

      <button
        type="button"
        onclick="document.getElementById('archivoChat').click()"
        style="
          width:55px;
          border:none;
          border-radius:50%;
          background:#2a3942;
          color:white;
          font-size:28px;
          cursor:pointer;
        "
      >
        +
      </button>

      <textarea
        name="respuesta"
        placeholder="Mensaje..."
      ></textarea>

      <button type="submit">➤</button>

      <button id="btnAudio" type="button" style="
        width:55px;
        border:none;
        border-radius:50%;
        background:#202c33;
        color:white;
        font-size:22px;
        cursor:pointer;
      ">
        🎤
      </button>

    </form>

<div
  id="previewArchivo"
  style="
    color:#25d366;
    font-size:13px;
    margin-top:8px;
  "
></div>

  </div>

<% } %>
</div>

<div id="miniEtiquetaModal" class="mini-etiqueta-modal">
  <div class="mini-etiqueta-box">

    <button class="mini-etiqueta-close" onclick="cerrarMiniEtiqueta()">×</button>

    <h3>🏷️ Etiquetar chat</h3>

    <form id="formMiniEtiqueta">
      <input type="hidden" name="numero" id="miniEtiquetaNumero">

      <select name="etiqueta" required>
  <% etiquetasDisponibles.forEach(et => { %>
    <option value="<%= et.nombre %>" data-color="<%= et.color || '#25d366' %>">
  <%= et.nombre %>
</option>
  <% }) %>
</select>

      <button type="submit" class="mini-etiqueta-save">
        Guardar etiqueta
      </button>
    </form>

    <form id="formQuitarEtiqueta">
      <input type="hidden" name="numero" id="miniQuitarEtiquetaNumero">

      <button type="submit" class="mini-etiqueta-remove">
        Quitar etiqueta
      </button>
    </form>

  </div>
</div>

<script>
  let numeroEtiquetaActual = null;
function abrirMiniEtiqueta(numero){
  numeroEtiquetaActual = numero;
  document.getElementById("miniEtiquetaNumero").value = numero;
  document.getElementById("miniQuitarEtiquetaNumero").value = numero;
  document.getElementById("miniEtiquetaModal").classList.add("activo");
}

function cerrarMiniEtiqueta(){
  document.getElementById("miniEtiquetaModal").classList.remove("activo");
}

document.addEventListener("DOMContentLoaded", () => {
  const form = document.getElementById("formMiniEtiqueta");

  if (!form) return;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const numero = document.getElementById("miniEtiquetaNumero").value;
    const etiqueta = form.querySelector('[name="etiqueta"]').value;

    if (!numero || !etiqueta) return;

    const formData = new FormData();
    formData.append("numero", numero);
    formData.append("etiqueta", etiqueta);

    await fetch("/guardar-etiqueta-chat", {
  method: "POST",
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    numero: numero,
    etiqueta: etiqueta
  })
});

    pintarEtiquetaEnChat(numero, etiqueta);
    cerrarMiniEtiqueta();
  });
});

function pintarEtiquetaEnChat(numero, etiqueta) {
  const item = document.querySelector('.chat-item[data-numero="' + numero + '"]');

  if (!item) return;

  const info = item.querySelector(".chat-info");

  if (!info) return;

  item.querySelectorAll(".chat-label-manual").forEach(el => el.remove());

  const span = document.createElement("span");
  span.className = "chat-label-manual";
  span.innerText = etiqueta;
  const opcion = document.querySelector('[name="etiqueta"] option[value="' + etiqueta + '"]');
const color = opcion?.dataset?.color || "#25d366";
span.style.background = color;

  const ultimoMensaje = info.querySelector(".chat-last-message");

  if (ultimoMensaje) {
    info.insertBefore(span, ultimoMensaje);
  } else {
    info.appendChild(span);
  }
}

document.addEventListener("DOMContentLoaded", () => {

  const formQuitar = document.getElementById("formQuitarEtiqueta");

  if (!formQuitar) return;

  formQuitar.addEventListener("submit", async (e) => {

    e.preventDefault();

    const numero =
      document.getElementById("miniQuitarEtiquetaNumero").value;

    if (!numero) return;

    const formData = new FormData();

    formData.append("numero", numero);

    await fetch("/quitar-etiqueta-chat", {
  method: "POST",
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    numero: numero
  })
});

    quitarEtiquetaVisual(numero);

    cerrarMiniEtiqueta();

  });

});

function quitarEtiquetaVisual(numero) {

  const item =
    document.querySelector('.chat-item[data-numero="' + numero + '"]');

  if (!item) return;

  item
    .querySelectorAll(".chat-label-manual")
    .forEach(el => el.remove());

}

</script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/autoscroll.js"></script>
<script src="/js/chat-menu.js"></script>
<script src="/js/inbox/media-render.js"></script>
<script src="/js/inbox/load-chat.js"></script>
<script src="/js/inbox/message-render.js"></script>
<script src="/js/inbox/socket-chat.js"></script>
<script src="/js/inbox/send-message.js"></script>
<script src="/js/preview.js"></script>
<script src="/js/audio-recorder.js"></script>